@echo off
chcp 65001 >nul
REM ============================================================
REM  Script : git-toolbox.cmd
REM  Author : Claude Code (Anthropic official CLI)
REM  Model  : glm-5.2 (Zhipu AI / GLM)
REM  Date   : 2026-08-15
REM  Purpose: Git menu - configure remote / pull / commit+push / compare / log / status / help
REM  Note   : Generated by AI. Update this header when modifying.
REM
REM  ====== CONFIG: edit these two lines to reuse in another project ======
REM    REMOTE_NAME   - the git remote this script operates on
REM    DEFAULT_BRANCH - the branch used for pull / push / compare
REM  =====================================================================
set "REMOTE_NAME=claude-sap"
set "DEFAULT_BRANCH=master"
REM ======================================================================

setlocal

REM Make config vars visible inside setlocal
set "REMOTE_NAME=%REMOTE_NAME%"
set "DEFAULT_BRANCH=%DEFAULT_BRANCH%"

REM Switch to script directory (works even when launched from a shortcut)
cd /d "%~dp0"

REM Verify we are inside a git repository
git rev-parse --is-inside-work-tree >nul 2>&1
if errorlevel 1 (
  echo.
  echo [ERROR] Not a Git repository. Place this script in the repo root.
  echo          Current dir: %cd%
  echo.
  pause
  goto :end
)

REM Check whether the configured remote exists; if not, configure it automatically
git remote get-url %REMOTE_NAME% >nul 2>&1
if errorlevel 1 goto :remote

:menu
cls
echo.
echo ============================================
echo                Git Toolbox
echo ============================================
echo.
echo   [1] Pull latest             (git pull)
echo   [2] Commit and push         (add + commit + push)
echo   [3] Compare local vs remote (fetch + diff)
echo   [4] View commit history     (git log)
echo   [5] Working tree status      (git status)
echo   [6] Configure remote        (git remote add)
echo   [7] Help
echo   [0] Exit
echo.
echo NOTE: First use? Choose [6] to configure the remote '%REMOTE_NAME%'.
echo.
set "choice="
set /p "choice=Choose [0-7]: "

if "%choice%"=="1" goto :pull
if "%choice%"=="2" goto :push
if "%choice%"=="3" goto :diff
if "%choice%"=="4" goto :log
if "%choice%"=="5" goto :status
if "%choice%"=="6" goto :remote
if "%choice%"=="7" goto :help
if "%choice%"=="0" goto :end
goto :menu

:remote
cls
echo.
echo --- Configure remote ---
echo.
set "rpath="
set /p "rpath=Paste remote repo path (Windows path OK): "
if "%rpath%"=="" (
  echo.
  echo [CANCELLED] Empty path.
  echo.
  pause
  goto :menu
)
REM Transform: strip double quotes, strip leading/trailing spaces, backslash to slash
set "rpath=%rpath:"=%"
:rlead
if not "%rpath:~0,1%"==" " goto :rleaddone
set "rpath=%rpath:~1%"
goto :rlead
:rleaddone
:rtrail
if not "%rpath:~-1%"==" " goto :rtraildone
set "rpath=%rpath:~0,-1%"
goto :rtrail
:rtraildone
set "rpath=%rpath:\=/%"
echo.
echo Converted path: %rpath%
echo.
REM Add or update the remote (idempotent)
git remote get-url %REMOTE_NAME% >nul 2>&1
if not errorlevel 1 (
  echo Remote '%REMOTE_NAME%' already exists. Updating its URL.
  git remote set-url %REMOTE_NAME% "%rpath%"
) else (
  git remote add %REMOTE_NAME% "%rpath%"
)
if errorlevel 1 goto :remoteerr
echo.
echo [DONE] Remote '%REMOTE_NAME%' ^-> %rpath%
echo.
pause
goto :menu
:remoteerr
echo.
echo [ERROR] Failed to configure remote. Check output above.
echo.
pause
goto :menu

:pull
cls
echo.
echo --- [1] Pull latest ---
echo.
git pull %REMOTE_NAME% %DEFAULT_BRANCH%
if errorlevel 1 (
  echo.
  echo [ERROR] Pull failed. Check output above.
)
echo.
pause
goto :menu

:push
cls
echo.
echo --- [2] Commit and push ---
echo.
set "msg="
set /p "msg=Commit message: "
if "%msg%"=="" (
  echo.
  echo [CANCELLED] Empty commit message.
  echo.
  pause
  goto :menu
)
echo.
echo [1/3] git add .
git add .
if errorlevel 1 goto :pusherr
echo.
echo [2/3] git commit -m "%msg%"
git commit -m "%msg%"
if errorlevel 1 goto :pusherr
echo.
echo [3/3] git push %REMOTE_NAME% %DEFAULT_BRANCH%
git push %REMOTE_NAME% %DEFAULT_BRANCH%
if errorlevel 1 goto :pusherr
echo.
echo [DONE] Pushed to %REMOTE_NAME%/%DEFAULT_BRANCH%
echo.
REM --- optional: tag a version ---
echo.
echo Current latest tag:
git --no-pager describe --tags --abbrev=0 2>nul
echo.
set "tagq="
set /p "tagq=Tag this version? (y/N): "
if /i not "%tagq%"=="y" (
  echo.
  pause
  goto :menu
)
:asktag
set "tagname="
set /p "tagname=Tag name (e.g. v1.2.0): "
if "%tagname%"=="" (
  echo.
  echo [CANCELLED] Empty tag name. Skipping tag.
  echo.
  pause
  goto :menu
)
REM reject if the tag already exists locally
git rev-parse --quiet --verify refs/tags/%tagname% >nul 2>&1
if not errorlevel 1 (
  echo.
  echo [ERROR] Tag '%tagname%' already exists locally. Use another name.
  echo.
  goto :asktag
)
git tag "%tagname%"
if errorlevel 1 goto :pusherr
echo.
echo Pushing tag %tagname% ...
git push %REMOTE_NAME% "%tagname%"
if errorlevel 1 (
  echo.
  echo [ERROR] Tag push failed. It may already exist on the remote.
  echo       Local tag '%tagname%' was created; remove with: git tag -d "%tagname%"
) else (
  echo.
  echo [DONE] Tagged and pushed %tagname%
)
echo.
pause
goto :menu
:pusherr
echo.
echo [ERROR] Push flow failed. Check output above.
echo.
pause
goto :menu

:diff
cls
echo.
echo --- [3] Compare local vs remote ---
echo.
echo Fetching remote info (git fetch)...
git fetch %REMOTE_NAME% %DEFAULT_BRANCH%
if errorlevel 1 (
  echo.
  echo [ERROR] Fetch failed. Check output above.
  echo.
  pause
  goto :menu
)
echo.
echo Commits ahead of remote (not pushed yet):
echo --------------------------------------------
git --no-pager log --oneline %REMOTE_NAME%/%DEFAULT_BRANCH%..HEAD
echo.
echo Commits behind remote (not pulled yet):
echo --------------------------------------------
git --no-pager log --oneline HEAD..%REMOTE_NAME%/%DEFAULT_BRANCH%
echo.
echo Note: an empty list means no new commits in that direction.
echo.
pause
goto :menu

:log
cls
echo.
echo --- [4] Commit history ---
echo.
echo hash   ^| date        ^| author                    ^| message
echo ----------------------------------------------------------------------
git -c i18n.logOutputEncoding=utf-8 --no-pager log -20 --decorate-refs=refs/tags --format="%%h %%x7c %%<(11)%%ad %%x7c %%<(26)%%an %%x7c %%d %%s" --date=short
if errorlevel 1 (
  echo.
  echo [ERROR] Failed to read history.
)
echo.
pause
goto :menu

:status
cls
echo.
echo --- [5] Working tree status ---
echo.
git -c core.quotepath=false status
if errorlevel 1 (
  echo.
  echo [ERROR] Failed to read status.
)
echo.
pause
goto :menu

:help
cls
echo.
echo ============================================
echo                     Help
echo ============================================
echo.
echo This script manages the current Git repo.
echo Config: remote = %REMOTE_NAME% , branch = %DEFAULT_BRANCH%.
echo Double-click to run, press a number, then press Enter.
echo.
echo [1] Pull latest
echo     Merge the latest from remote %REMOTE_NAME%/%DEFAULT_BRANCH% into local.
echo     Recommended to pull before starting work to avoid conflicts.
echo.
echo [2] Commit and push
echo     Asks for a commit message, then runs:
echo       git add .      stage all changes
echo       git commit -m  commit with the message
echo       git push       push to %REMOTE_NAME% %DEFAULT_BRANCH%
echo     Message cannot be empty. Special chars like quotes may fail.
echo     If nothing changed, commit reports nothing to commit.
echo     After push, optionally tag a version (e.g. v1.2.0) and push the tag.
echo.
echo [3] Compare local vs remote
echo     Fetches remote, then lists:
echo       - local commits not yet on remote (to push)
echo       - remote commits not yet local (to pull)
echo     An empty list means no new commits that way.
echo.
echo [4] Commit history
echo     Shows the last 20 commits, one per line.
echo.
echo [5] Working tree status
echo     Shows which files are modified/added/deleted and staged state.
echo.
echo [6] Configure remote
echo     Adds (or updates) remote '%REMOTE_NAME%' to a path you paste.
echo     Windows paths are auto-converted: quotes removed, leading/trailing
echo     spaces trimmed, backslashes turned to forward slashes.
echo.
echo [7] Help
echo     Shows this screen.
echo.
echo [0] Exit
echo.
echo --------------------------------------------
echo Note: Generated by Claude Code, model glm-5.2.
echo       Edit REMOTE_NAME / DEFAULT_BRANCH at top of this script to reuse
echo       in another project.
echo       If git errors occur, check network and remote path.
echo ============================================
echo.
pause
goto :menu

:end
endlocal
